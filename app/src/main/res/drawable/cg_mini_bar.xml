<?xml version="1.0" encoding="utf-8"?>
<!-- Cover Glow: the slim bar on the game screen once the header has scrolled away. Near-solid so
     the covers scrolling under it don't show through the title. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="#F2141226" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
</shape>
