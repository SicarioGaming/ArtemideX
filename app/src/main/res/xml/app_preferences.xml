<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <CheckBoxPreference
        android:key="checkbox_use_global_settings"
        android:title="Use Global Settings"
        android:summary="Do not use custom settings, instead use the global settings"
        android:defaultValue="true" />

    <PreferenceCategory 
        android:key="category_app_specific"
        android:title="App-Specific Settings">
        <Preference
            android:key="pref_app_resolution"
            android:title="@string/title_resolution_list"
            android:summary="@string/summary_resolution_list" />
        <EditTextPreference
            android:key="text_app_fps"
            android:title="@string/title_fps_list"
            android:summary="@string/summary_fps_list"
            android:inputType="number"
            android:dialogMessage="Enter FPS value" />
        <EditTextPreference
            android:key="text_app_bitrate_kbps"
            android:title="@string/title_seekbar_bitrate"
            android:summary="@string/summary_seekbar_bitrate"
            android:inputType="number"
            android:dialogMessage="Enter bitrate in Mbps (e.g. 50)" />
        <ListPreference
            android:key="list_app_frame_pacing"
            android:title="@string/title_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:summary="@string/summary_frame_pacing" />
        <EditTextPreference
            android:key="text_app_actual_display_refresh_rate"
            android:title="@string/title_actual_display_refresh_rate"
            android:summary="@string/summary_actual_display_refresh_rate"
            android:inputType="numberDecimal" />
        <ListPreference
            android:key="list_app_enable_hdr"
            android:title="@string/title_enable_hdr"
            android:entries="@array/hdr_setting_names"
            android:entryValues="@array/hdr_setting_values" />
        <ListPreference
            android:key="list_app_enable_perf_overlay"
            android:title="@string/title_enable_perf_overlay"
            android:entries="@array/perf_overlay_setting_names"
            android:entryValues="@array/perf_overlay_setting_values" />
        <!-- Voidlink options: "game_" plus the global setting's key (AppStreamSettings.GAME_OPTIONS) -->
        <ListPreference
            android:key="game_video_format"
            android:title="@string/title_video_format" />
        <ListPreference
            android:key="game_vsync_mode"
            android:title="@string/title_vsync_mode" />
        <ListPreference
            android:key="game_checkbox_sync_lfr"
            android:title="@string/title_checkbox_sync_lfr" />
        <ListPreference
            android:key="game_checkbox_async_decode"
            android:title="@string/title_checkbox_async_decode" />
        <ListPreference
            android:key="game_checkbox_async_lfr"
            android:title="@string/title_checkbox_async_lfr" />
        <ListPreference
            android:key="game_virtual_display_mode"
            android:title="@string/title_virtual_display_mode" />
        <ListPreference
            android:key="game_checkbox_touchscreen_trackpad"
            android:title="@string/title_game_touch_mode" />
        <ListPreference
            android:key="game_hide_cursor_mode"
            android:title="@string/title_hide_cursor_mode" />
        <ListPreference
            android:key="game_list_audio_haptics"
            android:title="@string/title_audio_haptics" />
    </PreferenceCategory>

</PreferenceScreen>