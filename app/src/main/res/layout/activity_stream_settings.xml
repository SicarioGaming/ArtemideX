<!-- Cover Glow settings: back button and title, a row of section pills, then the settings list -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0C1A1D"
    android:clipChildren="false"
    tools:context=".preferences.StreamSettings">

    <!-- The soft teal light in the corner -->
    <View
        android:layout_width="700dp"
        android:layout_height="700dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-260dp"
        android:layout_marginBottom="-400dp"
        android:alpha="0.35"
        android:background="@drawable/cg_glow"
        android:backgroundTint="#FF14B8A6"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settingsBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/cg_pill_frosted"
                android:contentDescription="@string/cg_back"
                android:src="@drawable/cg_ic_back" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="@string/cg_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/settingsSectionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settingsSections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/stream_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
